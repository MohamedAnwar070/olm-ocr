# Sample environment configuration — copy to .env and adjust.
# cp .env.example .env

# Model / inference backend (llama.cpp mtmd-cli + GGUF weights)
OCR_MODEL_PATH=./models/olmOCR-2-7B-1025-Q8_0.gguf
OCR_MMPROJ_PATH=./models/mmproj-olmOCR-2-7B-1025-f16.gguf
OCR_CLI_PATH=llama-mtmd-cli

# Inference tuning
OCR_GPU_LAYERS=999
OCR_MAX_TOKENS=6144
OCR_CTX_SIZE=8192

# API storage
OCR_UPLOAD_DIR=./uploads
OCR_OUTPUT_DIR=./ocr_output

# Optional API auth (leave empty to disable).
# When set, clients must send: Authorization: Bearer <key>
OCR_API_KEY=
